PORT=8080
# токен от @BotFather
BOT_TOKEN=
# короткое имя Mini App из BotFather /newapp (например, play). Пусто — используется Main Mini App бота
APP_SHORT_NAME=play
# публичный HTTPS-адрес игры (для кнопки в личке с ботом)
WEBAPP_URL=https://pref.example.ru/
# 1 — вход без Telegram по ?dev=Имя (только для локальной отладки!)
DEV=0
